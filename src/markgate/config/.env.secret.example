# .env_secret — MarkGate secrets
# Copy this file next to server_config.toml and fill in your values.

# ---------------------------------------------------------------------------
# S3 Storage Credentials
# ---------------------------------------------------------------------------
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme


# ---------------------------------------------------------------------------
# Var below are injected in backend_config.toml
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Client API Keys (per backend version)
# These are the Bearer tokens clients must send to access each version.
# ---------------------------------------------------------------------------
CLIENT_API_KEY_FOIL=changeme
CLIENT_API_KEY_FOIL_MINISTRAL_3_3B=changeme
CLIENT_API_KEY_FOIL_QWEN_3.5_27B=changeme
CLIENT_API_KEY_DOCLING_STANDARD=changeme
CLIENT_API_KEY_DOCLING_VLM=changeme
CLIENT_API_KEY_XBERG=changeme

# Bearer token for /auto/* routes (optional feature — see server_config.toml's
# auto_route_enabled). Independent of the per-backend keys above, since the backend isn't known
# until after the file is inspected.
CLIENT_API_KEY_AUTO=changeme

# Bearer token for POST /images (image lookup by document hash, e.g. from an open-webui tool).
# Not tied to a backend version. Empty = POST /images always rejected.
CLIENT_API_KEY_IMAGES=changeme

# ---------------------------------------------------------------------------
# Upstream Backend API Keys
# ---------------------------------------------------------------------------
UPSTREAM_FOIL_API_KEY=changeme
# UPSTREAM_DOCLING_API_KEY=changeme   # uncomment + the custom_headers of the docling-* backends if docling-serve sets api_key
# UPSTREAM_XBERG_API_KEY=changeme   # uncomment + set backends.xberg.custom_headers if your xberg deployment requires auth