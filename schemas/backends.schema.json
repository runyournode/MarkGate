    "FoilRouteAlias": {
      "additionalProperties": false,
      "description": "A static route alias exposing a preset of SpreadsheetOverrides as a URL path segment, for\nclients that cannot set query params. Registered as\n`/alias/{md/}{version}/{name}/process{/download}`. Resolves to the exact same FoilConfig\n(and cache entry / processing lock, see FoilConfig.cache_key()) as calling the parent\nVersion with the equivalent query params.",
      "properties": {
        "name": {
          "description": "URL path segment, e.g. 'spreadsheet_ocr' for /alias/{version}/spreadsheet_ocr/process.",
          "minLength": 1,
          "pattern": "^[a-z0-9_-]+$",
          "title": "Name",
          "type": "string"
        },
        "query_params": {
          "$ref": "#/$defs/SpreadsheetOverrides"
        }
      },
      "required": [
        "name",
        "query_params"
      ],
      "title": "FoilRouteAlias",
      "type": "object"
    },
    "SpreadsheetMode": {
      "description": "Mirrors foil_serve.schemas.SpreadsheetMode \u2014 the values foil-serve accepts.",
      "enum": [
        "auto",
        "pandas",
        "ocr",
        "both"
      ],
      "title": "SpreadsheetMode",
      "type": "string"
    },
    "SpreadsheetOverrides": {
      "additionalProperties": false,
      "description": "Per-request overrides for foil-backed Versions. A field left at None means \"no override \u2014\nuse this Version's configured value\". extra=\"forbid\" mainly matters for\nFoilRouteAlias.query_params, where this model validates a TOML dict and a typo'd/unsupported\nkey must fail at startup rather than be silently dropped.",
      "properties": {
        "spreadsheet_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpreadsheetMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "excel_min_output_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excel Min Output Ratio"
        }
      },
      "title": "SpreadsheetOverrides",
      "type": "object"
    },
